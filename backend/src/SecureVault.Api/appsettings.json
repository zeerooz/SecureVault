{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=securevault;Username=securevault;Password=securevault"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "securevault",
    "Audience": "securevault-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RateLimits": {
    "AuthPermitPerMinute": 10,
    "ApiPermitPerMinute": 300
  },
  "Lockout": {
    "MaxFailedAttempts": 8,
    "LockoutMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DataProtection": {
    "KeyPath": "/var/securevault/keys"
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
