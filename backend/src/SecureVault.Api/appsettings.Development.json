{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  // DEVELOPMENT ONLY.
  //
  // This signing key is committed deliberately so the project runs with a
  // single command after cloning. It is worthless: it signs tokens for a local
  // database full of fake data. Production reads Jwt__SigningKey from the
  // environment, and the app refuses to start if that value is missing or
  // shorter than 32 characters. Never copy this value into a deployment.
  "Jwt": {
    "SigningKey": "dev-only-insecure-signing-key-change-me-0123456789"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "DataProtection": {
    "KeyPath": "./.keys"
  }
}
